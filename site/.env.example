# From Cloudflare → Web Analytics → Manage site → JS snippet (token value only).
# For production: GitHub repo → Settings → Secrets → PUBLIC_CF_WEB_ANALYTICS_TOKEN
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# From Cloudflare Turnstile widget config (site key; public).
# For production: GitHub repo → Settings → Secrets → PUBLIC_CF_TURNSTILE_SITE_KEY
PUBLIC_CF_TURNSTILE_SITE_KEY=
