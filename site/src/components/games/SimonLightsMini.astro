<section class="game" data-simon-root>
  <h2>Simon Lights Mini</h2>
  <ol class="howto">
    <li>Press <strong>Start</strong>.</li>
    <li>Watch the flashing colors.</li>
    <li>Tap the same colors in the same order.</li>
  </ol>
  <p data-msg aria-live="polite">Watch the pattern, then repeat it.</p>
  <div class="grid">
    <button data-key="0" class="pad p1"></button>
    <button data-key="1" class="pad p2"></button>
    <button data-key="2" class="pad p3"></button>
    <button data-key="3" class="pad p4"></button>
  </div>
  <button data-start class="start">Start</button>
</section>

<script>
  function initSimon() {
    const root = document.querySelector('[data-simon-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    const msg = root.querySelector('[data-msg]');
    const pads = [...root.querySelectorAll('.pad')];
    const start = root.querySelector('[data-start]');
    let seq = [];
    let user = [];
    let playing = false;
    function flash(i) {
      pads[i].classList.add('on');
      setTimeout(() => pads[i].classList.remove('on'), 320);
    }
    function showSeq() {
      playing = true;
      user = [];
      msg.textContent = `Watch... pattern length ${seq.length}`;
      seq.forEach((n, i) => setTimeout(() => flash(n), 520 * (i + 1)));
      setTimeout(() => {
        playing = false;
        msg.textContent = `Your turn: tap step 1 of ${seq.length}`;
      }, 620 * (seq.length + 1));
    }
    start.addEventListener('click', () => {
      seq.push(Math.floor(Math.random() * 4));
      msg.textContent = `Round ${seq.length}`;
      showSeq();
    });
    pads.forEach((p, idx) => p.addEventListener('click', () => {
      if (playing || seq.length === 0) return;
      user.push(idx); flash(idx);
      const pos = user.length - 1;
      if (user[pos] !== seq[pos]) {
        msg.textContent = 'Wrong order. Press Start to try a new game.';
        seq = [];
      } else if (user.length === seq.length) {
        msg.textContent = 'Great! Next round...';
        setTimeout(() => start.click(), 650);
      } else {
        msg.textContent = `Good. Now tap step ${user.length + 1} of ${seq.length}.`;
      }
    }));
  }
  initSimon();
  document.addEventListener('astro:page-load', initSimon);
</script>

<style>
  .game {
    background:#f3fff8;
    padding:1rem;
    border-radius:14px;
    border:2px solid #27614c;
    color:#143327;
    text-align: center;
  }
  .howto {
    margin: 0 auto 0.6rem;
    max-width: 420px;
    text-align: left;
    font-size: clamp(.95rem, 3.9vw, 1.1rem);
  }
  .grid {
    display:grid;
    grid-template-columns: repeat(2, minmax(110px, 1fr));
    gap:.9rem;
    max-width: 320px;
    margin: 0.8rem auto 0.3rem;
  }
  :global(.pad) {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 1 / 1;
    border:2px solid #173126;
    border-radius:16px;
    opacity:.65;
    cursor: pointer;
    transform: scale(1);
    transition: transform .15s ease, filter .15s ease, opacity .15s ease, box-shadow .15s ease;
  }
  :global(.pad.on) {
    outline:4px solid #fff;
    opacity:1;
    filter: brightness(1.45) saturate(1.3);
    transform: scale(1.06);
    box-shadow: 0 0 0 4px rgba(255,255,255,.45), 0 0 16px rgba(255,255,255,.8);
  }
  :global(.p1){background:#ff9f9f}
  :global(.p2){background:#ffd88d}
  :global(.p3){background:#98d5ff}
  :global(.p4){background:#9cf0ad}
  [data-msg] {
    min-height: 1.6em;
    font-size: clamp(1.05rem, 4.8vw, 1.35rem);
    font-weight: 700;
  }
  .start {
    margin-top:.8rem;
    border-radius:12px;
    padding:.75rem 1.3rem;
    border:0;
    background:#324;
    color:#fff;
    font-size: clamp(1rem, 4.3vw, 1.2rem);
    font-weight: 700;
  }
</style>
