<section class="game" data-shape-root>
  <h2>Shape Sorter</h2>
  <p>Tap a shape, then tap the matching basket.</p>
  <div class="shape-row" data-shapes></div>
  <div class="basket-row">
    <button class="basket" data-basket="circle">Circle</button>
    <button class="basket" data-basket="square">Square</button>
    <button class="basket" data-basket="triangle">Triangle</button>
  </div>
  <p data-msg></p>
</section>

<script>
  function initShape() {
    const root = document.querySelector('[data-shape-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    const shapesWrap = root.querySelector('[data-shapes]');
    const msg = root.querySelector('[data-msg]');
    const shapes = ['circle', 'square', 'triangle', 'circle', 'square'];
    let selected = null;
    shapes.forEach((s) => {
      const b = document.createElement('button');
      b.className = `shape ${s}`;
      b.dataset.shape = s;
      b.addEventListener('click', () => { selected = b; msg.textContent = `Selected ${s}`; });
      shapesWrap.appendChild(b);
    });
    root.querySelectorAll('[data-basket]').forEach((basket) => {
      basket.addEventListener('click', () => {
        if (!selected) return;
        if (selected.dataset.shape === basket.dataset.basket) {
          selected.remove();
          msg.textContent = 'Great match!';
          selected = null;
        } else {
          msg.textContent = 'Oops, try another basket.';
        }
      });
    });
  }
  initShape();
  document.addEventListener('astro:page-load', initShape);
</script>

<style>
  .game { background:#f5f0ff; padding:1rem; border-radius:14px; }
  .shape-row, .basket-row { display:flex; gap:.6rem; flex-wrap:wrap; margin:.6rem 0; }
  .shape { width:56px; height:56px; border:0; background:#9bd6ff; }
  .shape.circle { border-radius:50%; }
  .shape.square { border-radius:8px; }
  .shape.triangle { width:0; height:0; border-left:30px solid transparent; border-right:30px solid transparent; border-bottom:56px solid #ffa3a3; background:transparent; }
  .basket { border:2px solid #bdaeff; background:#fff; border-radius:10px; padding:.5rem .8rem; }
</style>
