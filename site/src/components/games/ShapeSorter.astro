<section class="game" data-shape-root data-music-theme="dreamy">
  <h2>Shape Sorter</h2>
  <p class="listen-hint">Listen, then tap the shape you hear.</p>
  <p class="listen-pulse" data-listen aria-live="polite">
    <span class="ear" aria-hidden="true">👂</span>
    <span class="listen-label" data-listen-label>Tap Start</span>
  </p>
  <p class="feedback" data-feedback aria-live="assertive"></p>
  <div class="shape-grid" data-grid></div>
  <p class="progress">Done: <strong data-score>0</strong> / <span data-total>6</span></p>
  <button class="start-btn" data-start type="button">Start</button>
  <button class="stop-btn" data-stop type="button" hidden>Stop</button>
</section>

<script>
  import { audio, bindActivityUnlock } from '../../lib/activityAudio';

  const VISIBLE_COUNT = 6;
  const SET_ADVANCE_MS = 1400;
  const PROMPT_DELAY_MS = 320;

  /** Flat 2D vs isometric 3D — distinct SVG art per shape */
  const SHAPE_SVG = {
    circle:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="38" fill="#4dabf7" stroke="#1864ab" stroke-width="3"/></svg>',
    oval:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><ellipse cx="50" cy="50" rx="42" ry="26" fill="#74c0fc" stroke="#1864ab" stroke-width="3"/></svg>',
    square:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><rect x="22" y="22" width="56" height="56" rx="2" fill="#69db7c" stroke="#2f9e44" stroke-width="3"/></svg>',
    rectangle:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><rect x="6" y="34" width="88" height="32" rx="2" fill="#ffa94d" stroke="#e8590c" stroke-width="3"/></svg>',
    triangle:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,12 90,88 10,88" fill="#ff8787" stroke="#c92a2a" stroke-width="3" stroke-linejoin="round"/></svg>',
    diamond:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,8 92,50 50,92 8,50" fill="#ff6b9d" stroke="#c2255c" stroke-width="3" stroke-linejoin="round"/></svg>',
    pentagon:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,6 94,38 78,92 22,92 6,38" fill="#ffd43b" stroke="#e67700" stroke-width="3" stroke-linejoin="round"/></svg>',
    hexagon:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,6 92,28 92,72 50,94 8,72 8,28" fill="#da77f2" stroke="#9c36b5" stroke-width="3" stroke-linejoin="round"/></svg>',
    octagon:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="32,6 68,6 94,32 94,68 68,94 32,94 6,68 6,32" fill="#a9e34b" stroke="#5c940d" stroke-width="3" stroke-linejoin="round"/></svg>',
    star:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,4 61,36 96,36 68,56 79,92 50,72 21,92 32,56 4,36 39,36" fill="#fcc419" stroke="#e67700" stroke-width="2.5" stroke-linejoin="round"/></svg>',
    sphere:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><defs><radialGradient id="sg-sphere" cx="35%" cy="30%" r="65%"><stop offset="0%" stop-color="#fff"/><stop offset="35%" stop-color="#91a7ff"/><stop offset="100%" stop-color="#364fc7"/></radialGradient></defs><ellipse cx="50" cy="88" rx="28" ry="6" fill="#364fc7" opacity=".25"/><circle cx="50" cy="48" r="36" fill="url(#sg-sphere)" stroke="#364fc7" stroke-width="3"/><ellipse cx="38" cy="34" rx="10" ry="6" fill="#fff" opacity=".55"/></svg>',
    cube:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,14 78,30 50,46 22,30" fill="#c0eb75" stroke="#5c940d" stroke-width="2" stroke-linejoin="round"/><polygon points="22,30 50,46 50,78 22,62" fill="#94d82a" stroke="#5c940d" stroke-width="2" stroke-linejoin="round"/><polygon points="50,46 78,30 78,62 50,78" fill="#5c940d" stroke="#3b5c0d" stroke-width="2" stroke-linejoin="round"/></svg>',
    cuboid:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="14,34 70,34 78,26 22,26" fill="#b2f2ff" stroke="#2f6f9e" stroke-width="2" stroke-linejoin="round"/><polygon points="14,34 22,26 22,70 14,78" fill="#66d9e8" stroke="#2f6f9e" stroke-width="2" stroke-linejoin="round"/><polygon points="70,34 78,26 78,70 70,78" fill="#3bc9db" stroke="#1864ab" stroke-width="2" stroke-linejoin="round"/><polygon points="14,34 70,34 70,78 14,78" fill="#15aabf" stroke="#1864ab" stroke-width="2" stroke-linejoin="round"/></svg>',
    cylinder:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><defs><linearGradient id="sg-cyl" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#364fc7"/><stop offset="50%" stop-color="#91a7ff"/><stop offset="100%" stop-color="#364fc7"/></linearGradient></defs><ellipse cx="50" cy="78" rx="26" ry="9" fill="#364fc7" stroke="#212529" stroke-width="2"/><rect x="24" y="28" width="52" height="50" fill="url(#sg-cyl)" stroke="#364fc7" stroke-width="2"/><ellipse cx="50" cy="28" rx="26" ry="9" fill="#bac8ff" stroke="#364fc7" stroke-width="2"/><path d="M24 28 Q50 36 76 28" fill="none" stroke="#fff" stroke-width="2" opacity=".4"/></svg>',
    cone:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><defs><linearGradient id="sg-cone" x1="50%" y1="0%" x2="50%" y2="100%"><stop offset="0%" stop-color="#ffc078"/><stop offset="100%" stop-color="#e8590c"/></linearGradient></defs><ellipse cx="50" cy="82" rx="30" ry="10" fill="#d9480f" stroke="#9c3600" stroke-width="2"/><polygon points="50,14 82,80 18,80" fill="url(#sg-cone)" stroke="#c92a2a" stroke-width="2" stroke-linejoin="round"/><polygon points="50,14 66,80 18,80" fill="#fd7e14" opacity=".45"/></svg>',
    pyramid:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,88 14,72 86,72" fill="#e67700" stroke="#9c3600" stroke-width="2" stroke-linejoin="round"/><polygon points="50,88 86,72 50,12" fill="#fab005" stroke="#e67700" stroke-width="2" stroke-linejoin="round"/><polygon points="50,88 14,72 50,12" fill="#f59f00" stroke="#e67700" stroke-width="2" stroke-linejoin="round"/><polygon points="14,72 50,12 86,72" fill="#ffd43b" stroke="#e67700" stroke-width="2" stroke-linejoin="round" opacity=".35"/></svg>',
    prism:
      '<svg viewBox="0 0 100 100" aria-hidden="true"><polygon points="28,72 72,72 50,88" fill="#0ca678" stroke="#087f5b" stroke-width="2" stroke-linejoin="round"/><polygon points="28,72 50,28 72,72" fill="#63e6be" stroke="#087f5b" stroke-width="2" stroke-linejoin="round"/><polygon points="50,28 72,72 88,58 66,14" fill="#38d9a9" stroke="#087f5b" stroke-width="2" stroke-linejoin="round"/><polygon points="50,28 28,72 14,58 36,14" fill="#20c997" stroke="#087f5b" stroke-width="2" stroke-linejoin="round"/><line x1="50" y1="28" x2="66" y2="14" stroke="#087f5b" stroke-width="2"/><line x1="66" y1="14" x2="88" y2="58" stroke="#087f5b" stroke-width="2"/><line x1="88" y1="58" x2="72" y2="72" stroke="#087f5b" stroke-width="2"/></svg>',
  };

  const SHAPE_POOL = [
    { key: 'circle', label: 'Circle' },
    { key: 'oval', label: 'Oval' },
    { key: 'square', label: 'Square' },
    { key: 'rectangle', label: 'Rectangle' },
    { key: 'triangle', label: 'Triangle' },
    { key: 'diamond', label: 'Diamond' },
    { key: 'pentagon', label: 'Pentagon' },
    { key: 'hexagon', label: 'Hexagon' },
    { key: 'octagon', label: 'Octagon' },
    { key: 'star', label: 'Star' },
    { key: 'sphere', label: 'Sphere' },
    { key: 'cube', label: 'Cube' },
    { key: 'cuboid', label: 'Cuboid' },
    { key: 'cylinder', label: 'Cylinder' },
    { key: 'cone', label: 'Cone' },
    { key: 'pyramid', label: 'Pyramid' },
    { key: 'prism', label: 'Prism' },
  ];

  function initShape() {
    const root = document.querySelector('[data-shape-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    bindActivityUnlock(root, 'dreamy');

    const grid = root.querySelector('[data-grid]');
    const feedback = root.querySelector('[data-feedback]');
    const listenLabel = root.querySelector('[data-listen-label]');
    const listenBox = root.querySelector('[data-listen]');
    const scoreEl = root.querySelector('[data-score]');
    const totalEl = root.querySelector('[data-total]');
    const startBtn = root.querySelector('[data-start]');
    const stopBtn = root.querySelector('[data-stop]');

    let activeSet = [];
    let callOrder = [];
    let callIndex = 0;
    let doneCount = 0;
    let locked = false;
    let playing = false;
    let advanceTimer = null;
    let speakTimer = null;
    let setsCompleted = 0;

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function pickNewSet() {
      return shuffle(SHAPE_POOL).slice(0, VISIBLE_COUNT);
    }

    function shapeSvgHtml(shapeKey) {
      const raw = SHAPE_SVG[shapeKey] ?? SHAPE_SVG.circle;
      const uid = `${shapeKey}-${Math.random().toString(36).slice(2, 9)}`;
      return raw
        .replace(/\bid="sg-([^"]+)"/g, `id="sg-$1-${uid}"`)
        .replace(/url\(#sg-([^)]+)\)/g, `url(#sg-$1-${uid})`);
    }

    function addGlyph(button, shapeKey) {
      const glyph = document.createElement('span');
      glyph.className = `shape-glyph shape-glyph-${shapeKey}`;
      glyph.setAttribute('aria-hidden', 'true');
      glyph.innerHTML = shapeSvgHtml(shapeKey);
      button.appendChild(glyph);
    }

    function renderGrid(shapes) {
      grid.innerHTML = '';
      shapes.forEach((def) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'shape-tile';
        b.dataset.shape = def.key;
        b.setAttribute('aria-label', def.label);
        addGlyph(b, def.key);
        b.addEventListener('click', () => onTileClick(b, def));
        grid.appendChild(b);
      });
    }

    function getTile(key) {
      return grid.querySelector(`[data-shape="${key}"]`);
    }

    function speakShape(label, delayMs = 0) {
      if (speakTimer) clearTimeout(speakTimer);
      const run = () => {
        listenBox.classList.add('speaking');
        listenLabel.textContent = '…';
        audio.speak(label);
        window.setTimeout(() => {
          listenBox.classList.remove('speaking');
          listenLabel.textContent = 'Listen…';
        }, 400);
      };
      if (delayMs > 0) speakTimer = window.setTimeout(run, delayMs);
      else run();
    }

    function currentTarget() {
      return callOrder[callIndex];
    }

    function updateProgress() {
      scoreEl.textContent = String(doneCount);
      totalEl.textContent = String(VISIBLE_COUNT);
    }

    function promptNext() {
      if (callIndex >= callOrder.length) {
        completeSet();
        return;
      }
      locked = false;
      feedback.textContent = '';
      const def = currentTarget();
      if (!def) return;
      const tile = getTile(def.key);
      if (tile?.classList.contains('done')) {
        callIndex += 1;
        promptNext();
        return;
      }
      speakShape(def.label, PROMPT_DELAY_MS);
    }

    function markDone(tile) {
      tile.classList.remove('wrong');
      tile.classList.add('done');
      tile.disabled = true;
    }

    function onTileClick(tile, def) {
      if (!playing || locked || tile.classList.contains('done')) return;
      audio.unlock();

      const target = currentTarget();
      if (!target) return;

      if (def.key === target.key) {
        locked = true;
        markDone(tile);
        doneCount += 1;
        updateProgress();
        feedback.textContent = 'Yay!';
        audio.speak('Yay!');
        audio.playSfx('clink');
        callIndex += 1;

        if (doneCount >= VISIBLE_COUNT) {
          advanceTimer = window.setTimeout(completeSet, 650);
        } else {
          advanceTimer = window.setTimeout(() => {
            feedback.textContent = '';
            promptNext();
          }, 750);
        }
      } else {
        tile.classList.remove('wrong');
        void tile.offsetWidth;
        tile.classList.add('wrong');
        feedback.textContent = '';
        audio.playSfx('buzz');
        speakShape(target.label, 200);
      }
    }

    function completeSet() {
      locked = true;
      setsCompleted += 1;
      feedback.textContent = '★ All six!';
      audio.speak('Yay!');
      audio.playSfx('sparkle');
      root.classList.add('set-flash');
      advanceTimer = window.setTimeout(() => {
        root.classList.remove('set-flash');
        if (playing) startNewSet();
      }, SET_ADVANCE_MS);
    }

    function startNewSet() {
      activeSet = pickNewSet();
      callOrder = shuffle([...activeSet]);
      callIndex = 0;
      doneCount = 0;
      updateProgress();
      renderGrid(activeSet);
      listenLabel.textContent = 'Listen…';
      feedback.textContent = '';
      promptNext();
    }

    function startGame() {
      if (advanceTimer) clearTimeout(advanceTimer);
      if (speakTimer) clearTimeout(speakTimer);
      audio.stopAll();
      if (audio.musicOn) audio.startMusic('dreamy');

      playing = true;
      locked = false;
      setsCompleted = 0;
      feedback.textContent = '';
      startBtn.hidden = true;
      stopBtn.hidden = false;
      root.classList.remove('set-flash');
      startNewSet();
    }

    function stopGame() {
      playing = false;
      locked = true;
      if (advanceTimer) clearTimeout(advanceTimer);
      if (speakTimer) clearTimeout(speakTimer);
      startBtn.hidden = false;
      stopBtn.hidden = true;
      listenLabel.textContent = 'Tap Start';
      feedback.textContent = setsCompleted > 0 ? `Sets: ${setsCompleted}` : '';
      grid.innerHTML = '';
      root.classList.remove('set-flash');
    }

    startBtn.addEventListener('click', () => {
      audio.unlock();
      startGame();
    });
    stopBtn.addEventListener('click', stopGame);

    totalEl.textContent = String(VISIBLE_COUNT);
    updateProgress();
  }

  initShape();
  document.addEventListener('astro:page-load', initShape);
</script>

<style>
  .game {
    background: #f5f0ff;
    padding: 1rem;
    border-radius: 14px;
    border: 2px solid #6f4caf;
    color: #24153f;
    text-align: center;
  }

  .listen-hint {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .listen-pulse {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0 0 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: #fff;
    border: 2px solid #9b6fd4;
    min-height: 2.2rem;
  }

  .listen-pulse.speaking {
    background: #ede4ff;
    animation: listen-pop 0.5s ease;
  }

  .ear {
    font-size: 1.5rem;
  }

  .listen-label {
    font-size: 1.15rem;
    font-weight: 800;
    color: #4a2878;
  }

  @keyframes listen-pop {
    0% {
      transform: scale(0.95);
    }
    50% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }

  .feedback {
    min-height: 1.5rem;
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    color: #1f6b3a;
  }

  .shape-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(72px, 1fr));
    gap: 0.55rem;
    max-width: 360px;
    margin: 0.5rem auto;
  }

  :global(.shape-tile) {
    all: unset;
    box-sizing: border-box;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 2px solid #6f4caf;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 12px;
  }

  :global(.shape-tile.done) {
    background: #dfffe8;
    border-color: #2f9e44;
    cursor: default;
    pointer-events: none;
  }

  :global(.shape-tile.done::after) {
    content: '✓';
    position: absolute;
    top: 0.15rem;
    right: 0.2rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: #2f9e44;
    line-height: 1;
  }

  :global(.shape-tile.done .shape-glyph) {
    opacity: 0.55;
  }

  :global(.shape-tile.wrong) {
    animation: tile-shake 0.4s ease;
  }

  @keyframes tile-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25%,
    75% {
      transform: translateX(-4px);
    }
    50% {
      transform: translateX(4px);
    }
  }

  .game.set-flash {
    background: linear-gradient(180deg, #fff9e6 0%, #efe8ff 100%);
  }

  .progress {
    margin: 0.4rem 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .start-btn,
  .stop-btn {
    border: 2px solid #2f6f4e;
    background: #2f6f4e;
    color: #fff;
    border-radius: 999px;
    padding: 0.55rem 1.2rem;
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    margin: 0 0.25rem;
  }

  .stop-btn {
    border-color: #6f4caf;
    background: #fff;
    color: #4a2878;
  }

  :global(.shape-glyph) {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 80%;
    height: 80%;
  }

  :global(.shape-glyph svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* 3D tiles: slightly taller slot so solids read clearly */
  :global(.shape-tile:has(.shape-glyph-sphere)),
  :global(.shape-tile:has(.shape-glyph-cube)),
  :global(.shape-tile:has(.shape-glyph-cuboid)),
  :global(.shape-tile:has(.shape-glyph-cylinder)),
  :global(.shape-tile:has(.shape-glyph-cone)),
  :global(.shape-tile:has(.shape-glyph-pyramid)),
  :global(.shape-tile:has(.shape-glyph-prism)) {
    background: linear-gradient(180deg, #fff 0%, #f0f4ff 100%);
  }
</style>
