<section class="game" data-shape-root data-music-theme="dreamy">
  <h2>Shape Sorter</h2>
  <p>Tap a shape, then tap the matching basket.</p>
  <div class="shape-row" data-shapes></div>
  <div class="basket-row" data-baskets></div>
  <p data-msg aria-live="polite"></p>
  <p class="reload-wrap" data-reload-wrap hidden>
    <button class="reload-btn" data-reload type="button">Reload Activity</button>
  </p>
</section>

<script>
  import { audio, bindActivityUnlock } from '../../lib/activityAudio';

  function initShape() {
    const root = document.querySelector('[data-shape-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    bindActivityUnlock(root, 'dreamy');
    const shapesWrap = root.querySelector('[data-shapes]');
    const basketsWrap = root.querySelector('[data-baskets]');
    const msg = root.querySelector('[data-msg]');
    const reloadWrap = root.querySelector('[data-reload-wrap]');
    const reloadBtn = root.querySelector('[data-reload]');

    const shapePool = [
      { key: 'circle', label: 'Circle' },
      { key: 'square', label: 'Square' },
      { key: 'triangle', label: 'Triangle' },
      { key: 'rectangle', label: 'Rectangle' },
      { key: 'hexagon', label: 'Hexagon' },
      { key: 'pentagon', label: 'Pentagon' },
    ];

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function addShapeGlyph(button, shapeKey) {
      const glyph = document.createElement('span');
      glyph.className = `shape-glyph shape-glyph-${shapeKey}`;
      glyph.setAttribute('aria-hidden', 'true');
      button.appendChild(glyph);
    }

    function renderRound() {
      shapesWrap.innerHTML = '';
      basketsWrap.innerHTML = '';
      reloadWrap.hidden = true;
      msg.textContent = '';
      let selected = null;
      let solved = 0;

      const activeTypes = shuffle(shapePool).slice(0, 3);
      const shapes = shuffle([...activeTypes, ...activeTypes]);

      shapes.forEach((shapeDef) => {
        const b = document.createElement('button');
        b.className = `shape tile-${shapeDef.key}`;
        b.dataset.shape = shapeDef.key;
        b.type = 'button';
        b.setAttribute('aria-label', shapeDef.label);
        addShapeGlyph(b, shapeDef.key);
        b.addEventListener('click', () => {
          if (b.classList.contains('matched')) return;
          selected = b;
          msg.textContent = shapeDef.label;
          audio.speak(shapeDef.label);
        });
        shapesWrap.appendChild(b);
      });

      activeTypes.forEach((shapeDef) => {
        const basket = document.createElement('button');
        basket.className = 'basket';
        basket.dataset.basket = shapeDef.key;
        basket.type = 'button';
        basket.setAttribute('aria-label', `${shapeDef.label} basket`);
        const preview = document.createElement('span');
        preview.className = `basket-glyph shape-glyph shape-glyph-${shapeDef.key}`;
        preview.setAttribute('aria-hidden', 'true');
        const label = document.createElement('span');
        label.className = 'basket-label';
        label.textContent = shapeDef.label;
        basket.append(preview, label);
        basket.addEventListener('click', () => {
          if (!selected) return;
          if (selected.dataset.shape === basket.dataset.basket) {
            selected.classList.add('matched');
            selected.disabled = true;
            solved += 1;
            selected = null;
            msg.textContent = 'Yes!';
            audio.speak('Yes!');
            audio.playSfx('clink');
            if (solved === shapes.length) {
              msg.textContent = 'All done!';
              audio.speak('All done!');
              reloadWrap.hidden = false;
            }
          } else {
            msg.textContent = 'Try again!';
            audio.speak('Try again!');
            audio.playSfx('buzz');
          }
        });
        basketsWrap.appendChild(basket);
      });
    }

    reloadBtn.addEventListener('click', renderRound);
    renderRound();
  }
  initShape();
  document.addEventListener('astro:page-load', initShape);
</script>

<style>
  .game {
    background: #f5f0ff;
    padding: 1rem;
    border-radius: 14px;
    border: 2px solid #6f4caf;
    color: #24153f;
    text-align: center;
  }

  .shape-row,
  .basket-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(90px, 1fr));
    gap: 0.8rem;
    max-width: 420px;
    margin: 0.8rem auto;
    justify-content: center;
  }

  :global(.shape) {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 2px solid #6f4caf;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 14px;
    padding: 0;
  }

  :global(.shape-glyph) {
    display: block;
    flex-shrink: 0;
  }

  /* Proper shapes at 80% of the tile */
  :global(.shape .shape-glyph) {
    width: 80%;
    height: 80%;
  }

  :global(.shape-glyph-circle) {
    border-radius: 50%;
    background: #4dabf7;
    border: 3px solid #1864ab;
  }

  :global(.shape-glyph-square) {
    width: 80%;
    height: 80%;
    background: #69db7c;
    border: 3px solid #2f9e44;
    border-radius: 4px;
  }

  :global(.shape-glyph-triangle) {
    width: 80%;
    height: 80%;
    background: #ff8787;
    border: none;
    clip-path: polygon(50% 6%, 6% 94%, 94% 94%);
  }

  :global(.shape-glyph-rectangle) {
    width: 80%;
    height: 52%;
    background: #ffa94d;
    border: 3px solid #e8590c;
    border-radius: 4px;
  }

  :global(.shape-glyph-pentagon) {
    width: 80%;
    height: 80%;
    background: #ffd43b;
    border: none;
    clip-path: polygon(50% 4%, 96% 38%, 78% 92%, 22% 92%, 4% 38%);
  }

  :global(.shape-glyph-hexagon) {
    width: 80%;
    height: 80%;
    background: #da77f2;
    border: none;
    clip-path: polygon(50% 4%, 92% 27%, 92% 73%, 50% 96%, 8% 73%, 8% 27%);
  }

  :global(.shape.matched) {
    background: #e8ffe8;
    border-color: #24763b;
  }

  :global(.shape.matched .shape-glyph) {
    filter: brightness(1.05);
    box-shadow: 0 0 0 3px #7be08e;
  }

  .basket {
    border: 2px solid #6f4caf;
    background: #fff;
    border-radius: 12px;
    padding: 0.65rem 0.5rem;
    width: 100%;
    min-height: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  :global(.basket .shape-glyph) {
    width: 2rem;
    height: 2rem;
  }

  :global(.basket .shape-glyph-rectangle) {
    width: 2.4rem;
    height: 1.35rem;
  }

  .basket-label {
    font-size: clamp(0.95rem, 4vw, 1.15rem);
    line-height: 1.1;
    font-weight: 700;
    color: #24153f;
  }

  .reload-wrap {
    margin-top: 1rem;
    text-align: center;
  }

  .reload-btn {
    border: 2px solid #2f6f4e;
    background: #2f6f4e;
    color: #fff;
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-weight: 700;
    cursor: pointer;
  }

  [data-msg] {
    min-height: 1.6em;
    font-size: clamp(1.15rem, 4.8vw, 1.4rem);
    font-weight: 700;
    margin-top: 0.55rem;
  }
</style>
