<section class="game" data-shape-root data-music-theme="dreamy">
  <h2>Shape Sorter</h2>
  <p class="listen-hint" data-hint>Listen, then tap the shape you hear.</p>
  <p class="listen-pulse" data-listen aria-live="polite">
    <span class="ear" aria-hidden="true">👂</span>
    <span class="listen-label" data-listen-label>Tap Start</span>
  </p>
  <p class="feedback" data-feedback aria-live="assertive"></p>
  <div class="shape-grid" data-grid></div>
  <p class="progress">★ <strong data-score>0</strong> / <span data-total>8</span></p>
  <p class="next-wrap" data-next-wrap hidden>
    <button class="next-btn" data-next type="button">Again!</button>
  </p>
  <button class="start-btn" data-start type="button">Start</button>
</section>

<script>
  import { audio, bindActivityUnlock } from '../../lib/activityAudio';

  const SHAPE_POOL = [
    { key: 'circle', label: 'Circle' },
    { key: 'triangle', label: 'Triangle' },
    { key: 'rectangle', label: 'Rectangle' },
    { key: 'square', label: 'Square' },
    { key: 'pentagon', label: 'Pentagon' },
    { key: 'hexagon', label: 'Hexagon' },
    { key: 'cone', label: 'Cone' },
    { key: 'cylinder', label: 'Cylinder' },
    { key: 'prism', label: 'Prism' },
    { key: 'cube', label: 'Cube' },
  ];

  const ROUNDS_PER_GAME = 8;
  const ADVANCE_MS = 1100;

  function initShape() {
    const root = document.querySelector('[data-shape-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    bindActivityUnlock(root, 'dreamy');

    const grid = root.querySelector('[data-grid]');
    const feedback = root.querySelector('[data-feedback]');
    const listenLabel = root.querySelector('[data-listen-label]');
    const listenBox = root.querySelector('[data-listen]');
    const scoreEl = root.querySelector('[data-score]');
    const totalEl = root.querySelector('[data-total]');
    const startBtn = root.querySelector('[data-start]');
    const nextWrap = root.querySelector('[data-next-wrap]');
    const nextBtn = root.querySelector('[data-next]');

    const tileByKey = new Map();
    let queue = [];
    let queueIndex = 0;
    let score = 0;
    let locked = false;
    let playing = false;
    let advanceTimer = null;
    let speakTimer = null;

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function addGlyph(button, shapeKey) {
      const glyph = document.createElement('span');
      glyph.className = `shape-glyph shape-glyph-${shapeKey}`;
      glyph.setAttribute('aria-hidden', 'true');
      button.appendChild(glyph);
    }

    function buildGrid() {
      grid.innerHTML = '';
      tileByKey.clear();
      SHAPE_POOL.forEach((def) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'shape-tile';
        b.dataset.shape = def.key;
        b.setAttribute('aria-label', def.label);
        addGlyph(b, def.key);
        b.addEventListener('click', () => onTileClick(b, def));
        grid.appendChild(b);
        tileByKey.set(def.key, b);
      });
    }

    function clearTileStates() {
      tileByKey.forEach((tile) => {
        tile.disabled = false;
        tile.classList.remove('correct', 'wrong', 'want');
      });
    }

    function speakShape(label, delayMs = 0) {
      if (speakTimer) clearTimeout(speakTimer);
      const run = () => {
        listenBox.classList.add('speaking');
        listenLabel.textContent = '…';
        audio.speak(label);
        window.setTimeout(() => {
          listenBox.classList.remove('speaking');
          listenLabel.textContent = 'Listen…';
        }, 400);
      };
      if (delayMs > 0) speakTimer = window.setTimeout(run, delayMs);
      else run();
    }

    function currentTarget() {
      return queue[queueIndex];
    }

    function promptNext() {
      if (queueIndex >= queue.length) {
        finishGame();
        return;
      }
      const def = currentTarget();
      locked = false;
      clearTileStates();
      feedback.textContent = '';
      speakShape(def.label, 280);
    }

    function onTileClick(tile, def) {
      if (!playing || locked) return;
      audio.unlock();

      const target = currentTarget();
      if (!target) return;

      if (def.key === target.key) {
        locked = true;
        tile.classList.add('correct');
        tileByKey.forEach((t) => {
          t.disabled = true;
        });
        score += 1;
        scoreEl.textContent = String(score);
        feedback.textContent = 'Yay!';
        audio.speak('Yay!');
        audio.playSfx('clink');
        root.classList.add('round-win');
        queueIndex += 1;
        advanceTimer = window.setTimeout(() => {
          root.classList.remove('round-win');
          promptNext();
        }, ADVANCE_MS);
      } else {
        tile.classList.remove('wrong');
        void tile.offsetWidth;
        tile.classList.add('wrong');
        feedback.textContent = '';
        audio.playSfx('buzz');
        speakShape(target.label, 200);
      }
    }

    function finishGame() {
      playing = false;
      locked = true;
      startBtn.hidden = false;
      nextWrap.hidden = false;
      listenLabel.textContent = 'Done!';
      feedback.textContent = '★ ★ ★';
      audio.speak('Yay!');
      audio.playSfx('success');
      root.classList.add('all-done');
      tileByKey.forEach((t) => {
        t.disabled = true;
        t.classList.add('correct');
      });
    }

    function startGame() {
      if (advanceTimer) clearTimeout(advanceTimer);
      if (speakTimer) clearTimeout(speakTimer);
      audio.stopAll();
      if (audio.musicOn) audio.startMusic('dreamy');

      playing = true;
      locked = true;
      score = 0;
      queueIndex = 0;
      scoreEl.textContent = '0';
      totalEl.textContent = String(ROUNDS_PER_GAME);
      feedback.textContent = '';
      startBtn.hidden = true;
      nextWrap.hidden = true;
      root.classList.remove('all-done', 'round-win');

      const picks = shuffle(SHAPE_POOL).slice(0, ROUNDS_PER_GAME);
      queue = picks;
      clearTileStates();
      listenLabel.textContent = 'Listen…';
      promptNext();
    }

    function resetUI() {
      playing = false;
      locked = false;
      if (advanceTimer) clearTimeout(advanceTimer);
      if (speakTimer) clearTimeout(speakTimer);
      startBtn.hidden = false;
      nextWrap.hidden = true;
      listenLabel.textContent = 'Tap Start';
      feedback.textContent = '';
      root.classList.remove('all-done', 'round-win');
      clearTileStates();
    }

    startBtn.addEventListener('click', () => {
      audio.unlock();
      startGame();
    });
    nextBtn.addEventListener('click', () => {
      audio.unlock();
      resetUI();
      startGame();
    });

    buildGrid();
    resetUI();
  }

  initShape();
  document.addEventListener('astro:page-load', initShape);
</script>

<style>
  .game {
    background: #f5f0ff;
    padding: 1rem;
    border-radius: 14px;
    border: 2px solid #6f4caf;
    color: #24153f;
    text-align: center;
  }

  .listen-hint {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .listen-pulse {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0 0 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: #fff;
    border: 2px solid #9b6fd4;
    min-height: 2.2rem;
  }

  .listen-pulse.speaking {
    background: #ede4ff;
    animation: listen-pop 0.5s ease;
  }

  .ear {
    font-size: 1.5rem;
    line-height: 1;
  }

  .listen-label {
    font-size: 1.15rem;
    font-weight: 800;
    color: #4a2878;
  }

  @keyframes listen-pop {
    0% {
      transform: scale(0.95);
    }
    50% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }

  .feedback {
    min-height: 1.5rem;
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    color: #1f6b3a;
  }

  .shape-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(58px, 1fr));
    gap: 0.5rem;
    max-width: 440px;
    margin: 0.5rem auto;
  }

  :global(.shape-tile) {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 2px solid #6f4caf;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 12px;
    padding: 0;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  :global(.shape-tile:disabled) {
    cursor: default;
  }

  :global(.shape-tile.want) {
    box-shadow: 0 0 0 3px #ffd54a;
  }

  :global(.shape-tile.correct) {
    background: #e8ffe8;
    border-color: #2f9e44;
  }

  :global(.shape-tile.wrong) {
    animation: tile-shake 0.4s ease;
  }

  @keyframes tile-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25%,
    75% {
      transform: translateX(-4px);
    }
    50% {
      transform: translateX(4px);
    }
  }

  .game.round-win {
    background: #efe8ff;
  }

  .game.all-done {
    background: linear-gradient(180deg, #fff9e6 0%, #efe8ff 100%);
  }

  .progress {
    margin: 0.4rem 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .start-btn,
  .next-btn {
    border: 2px solid #2f6f4e;
    background: #2f6f4e;
    color: #fff;
    border-radius: 999px;
    padding: 0.55rem 1.35rem;
    font-weight: 800;
    font-size: 1.05rem;
    cursor: pointer;
  }

  .next-wrap {
    margin: 0.35rem 0 0.5rem;
  }

  /* Shape glyphs ~75% of tile */
  :global(.shape-glyph) {
    display: block;
    flex-shrink: 0;
  }

  :global(.shape-tile .shape-glyph) {
    width: 75%;
    height: 75%;
  }

  :global(.shape-glyph-circle) {
    border-radius: 50%;
    background: #4dabf7;
    border: 2px solid #1864ab;
  }

  :global(.shape-glyph-square) {
    background: #69db7c;
    border: 2px solid #2f9e44;
    border-radius: 3px;
  }

  :global(.shape-glyph-triangle) {
    background: #ff8787;
    clip-path: polygon(50% 6%, 6% 94%, 94% 94%);
  }

  :global(.shape-glyph-rectangle) {
    width: 75%;
    height: 48%;
    background: #ffa94d;
    border: 2px solid #e8590c;
    border-radius: 3px;
  }

  :global(.shape-glyph-pentagon) {
    background: #ffd43b;
    clip-path: polygon(50% 4%, 96% 38%, 78% 92%, 22% 92%, 4% 38%);
  }

  :global(.shape-glyph-hexagon) {
    background: #da77f2;
    clip-path: polygon(50% 4%, 92% 27%, 92% 73%, 50% 96%, 8% 73%, 8% 27%);
  }

  :global(.shape-glyph-cone) {
    position: relative;
    width: 70%;
    height: 75%;
  }

  :global(.shape-glyph-cone::before) {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    border-left: 38% solid transparent;
    border-right: 38% solid transparent;
    border-bottom: 60% solid #ff922b;
  }

  :global(.shape-glyph-cone::after) {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 76%;
    height: 14%;
    background: #fd7e14;
    border: 2px solid #e8590c;
    border-radius: 50%;
  }

  :global(.shape-glyph-cylinder) {
    position: relative;
    width: 48%;
    height: 75%;
    background: linear-gradient(90deg, #4c6ef5, #91a7ff, #364fc7);
    border: 2px solid #364fc7;
    border-radius: 6px;
  }

  :global(.shape-glyph-cylinder::before),
  :global(.shape-glyph-cylinder::after) {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 110%;
    height: 20%;
    border: 2px solid #364fc7;
    border-radius: 50%;
  }

  :global(.shape-glyph-cylinder::before) {
    top: -10%;
    background: #bac8ff;
  }

  :global(.shape-glyph-cylinder::after) {
    bottom: -8%;
    background: #5c7cfa;
  }

  :global(.shape-glyph-prism) {
    position: relative;
  }

  :global(.shape-glyph-prism::before) {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(50% 6%, 94% 92%, 6% 92%);
    background: #63e6be;
    border: 2px solid #0ca678;
  }

  :global(.shape-glyph-prism::after) {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(50% 6%, 94% 92%, 50% 92%);
    background: #38d9a9;
  }

  :global(.shape-glyph-cube) {
    position: relative;
    width: 54%;
    height: 54%;
    margin-top: 4%;
  }

  :global(.shape-glyph-cube::before),
  :global(.shape-glyph-cube::after) {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border: 2px solid #5c940d;
    border-radius: 3px;
  }

  :global(.shape-glyph-cube::before) {
    background: #94d82a;
    transform: rotate(-28deg) skewX(-18deg);
  }

  :global(.shape-glyph-cube::after) {
    background: #c0eb75;
    transform: rotate(-28deg) skewX(-18deg) translate(20%, -22%);
    z-index: -1;
  }
</style>
