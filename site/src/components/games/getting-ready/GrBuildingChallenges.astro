---
import './gr-game.css';
---

<section class="gr-play" data-gr-build data-music-theme="marimba">
  <h2>Build mission</h2>
  <p class="challenge" data-card></p>
  <div class="gr-btn-row">
    <button class="gr-btn" data-next type="button">Done — next!</button>
  </div>
</section>

<script>
  import { audio, bindActivityUnlock } from '../../../lib/activityAudio';

  const CHALLENGES = [
    'Build the tallest tower you can.',
    'Make a bridge between two books.',
    'Build a house with a door.',
    'Make something that rolls.',
    'Build an animal shape.',
    'Create a rainbow with colorful blocks.',
    'Build a chair for a toy.',
    'Make a zigzag wall.',
  ];

  function init() {
    const root = document.querySelector('[data-gr-build]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    bindActivityUnlock(root, 'marimba');
    const card = root.querySelector('[data-card]');

    function next() {
      const text = CHALLENGES[Math.floor(Math.random() * CHALLENGES.length)];
      card.textContent = text;
      audio.speak(text);
    }

    root.querySelector('[data-next]')?.addEventListener('click', () => {
      audio.playSfx('chime');
      next();
    });
    next();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .challenge {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.4;
    background: #d3f9d8;
    border: 2px solid #40c057;
    border-radius: 14px;
    padding: 1rem;
    min-height: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.5rem 0;
  }
</style>
