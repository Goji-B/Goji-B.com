---
import './gr-game.css';
---

<section class="gr-play" data-gr-memory data-music-theme="musicbox">
  <h2>Match the pairs</h2>
  <p class="gr-msg" data-msg>Tap two cards.</p>
  <div class="mem-grid" data-grid></div>
  <div class="gr-btn-row">
    <button class="gr-btn" data-restart type="button">New board</button>
  </div>
</section>

<script>
  import { audio, bindActivityUnlock } from '../../../lib/activityAudio';

  function init() {
    const root = document.querySelector('[data-gr-memory]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    bindActivityUnlock(root, 'musicbox');
    const grid = root.querySelector('[data-grid]');
    const msg = root.querySelector('[data-msg]');
    const restart = root.querySelector('[data-restart]');
    const pool = ['🌟', '🌙', '🌈', '⚽', '🎈', '🍎', '🚗', '🐝', '🎵', '🦋'];

    function shuffle(a) {
      const c = [...a];
      for (let i = c.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [c[i], c[j]] = [c[j], c[i]];
      }
      return c;
    }

    function round() {
      grid.innerHTML = '';
      msg.textContent = 'Tap two cards.';
      const picked = shuffle(pool).slice(0, 6);
      const cards = shuffle([...picked, ...picked]);
      let first = null;
      let lock = false;
      let matched = 0;

      cards.forEach((sym) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'mem-card';
        b.textContent = '?';
        b.dataset.sym = sym;
        b.addEventListener('click', () => {
          if (lock || b.classList.contains('ok') || b === first) return;
          b.textContent = sym;
          audio.playSfx('flip');
          if (!first) {
            first = b;
            return;
          }
          if (first.dataset.sym === sym) {
            first.classList.add('ok');
            b.classList.add('ok');
            matched += 2;
            first = null;
            audio.playSfx('match');
            audio.speak('Match!');
            if (matched === cards.length) {
              msg.textContent = 'All pairs found!';
              audio.speak('You did it!');
            }
          } else {
            lock = true;
            audio.playSfx('thud');
            setTimeout(() => {
              first.textContent = '?';
              b.textContent = '?';
              first = null;
              lock = false;
            }, 650);
          }
        });
        grid.appendChild(b);
      });
    }

    restart?.addEventListener('click', round);
    round();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .mem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    max-width: 320px;
    margin: 0 auto;
  }

  :global(.mem-card) {
    all: unset;
    box-sizing: border-box;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    background: #e7f5ff;
    border: 2px solid #74c0fc;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 800;
    color: #1864ab;
  }

  :global(.mem-card.ok) {
    background: #d3f9d8;
    border-color: #40c057;
  }
</style>
