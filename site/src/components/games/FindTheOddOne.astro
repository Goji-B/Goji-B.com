<section class="game" data-odd-root>
  <h2>Find the Odd One</h2>
  <p data-msg>Tap the one that is different.</p>
  <div class="grid" data-grid></div>
</section>

<script>
  function initOdd() {
    const root = document.querySelector('[data-odd-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    const grid = root.querySelector('[data-grid]');
    const msg = root.querySelector('[data-msg]');
    const same = '🐶';
    const odd = '🐱';
    const oddIndex = Math.floor(Math.random() * 9);
    for (let i = 0; i < 9; i += 1) {
      const b = document.createElement('button');
      b.className = 'cell';
      b.textContent = i === oddIndex ? odd : same;
      b.addEventListener('click', () => {
        msg.textContent = i === oddIndex ? 'You found it! Great eyes.' : 'Not this one. Try again!';
      });
      grid.appendChild(b);
    }
  }
  initOdd();
  document.addEventListener('astro:page-load', initOdd);
</script>

<style>
  .game { background:#fffcee; padding:1rem; border-radius:14px; }
  .grid { display:grid; grid-template-columns:repeat(3,70px); gap:.6rem; }
  .cell { font-size:1.8rem; border-radius:10px; border:2px solid #f0d999; background:#fff; }
</style>
