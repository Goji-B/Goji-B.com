<section class="game" data-fruit-root data-music-theme="acoustic">
  <h2>Count the Fruits</h2>
  <p class="score-line" data-score>Score: 0</p>
  <p data-question>How many fruits do you see?</p>
  <div class="fruits" data-fruits></div>
  <div class="answers" data-answers></div>
  <p data-msg aria-live="polite"></p>
</section>

<script>
  import { audio, bindActivityUnlock } from '../../lib/activityAudio';

  function initFruit() {
    const root = document.querySelector('[data-fruit-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    bindActivityUnlock(root, 'acoustic');
    const question = root.querySelector('[data-question]');
    const fruits = root.querySelector('[data-fruits]');
    const answers = root.querySelector('[data-answers]');
    const msg = root.querySelector('[data-msg]');
    const scoreEl = root.querySelector('[data-score]');
    const fruitPool = [
      { emoji: '🍎', name: 'apples' },
      { emoji: '🍌', name: 'bananas' },
      { emoji: '🍊', name: 'oranges' },
      { emoji: '🍓', name: 'strawberries' },
      { emoji: '🍇', name: 'grapes' },
      { emoji: '🍐', name: 'pears' },
    ];
    let score = 0;

    function updateScore() {
      scoreEl.textContent = `Score: ${score}`;
    }

    function nextRound() {
      const picked = fruitPool[Math.floor(Math.random() * fruitPool.length)];
      const count = Math.floor(Math.random() * 6) + 3; // 3..8
      question.textContent = `How many ${picked.name}?`;
      fruits.textContent = picked.emoji.repeat(count);
      audio.speak(`How many ${picked.name}?`);
      answers.innerHTML = '';
      msg.textContent = '';

      const options = [count - 1, count, count + 1]
        .filter((n) => n > 0)
        .sort(() => Math.random() - 0.5);

      options.forEach((n) => {
        const b = document.createElement('button');
        b.className = 'fruit-ans';
        b.type = 'button';
        b.textContent = String(n);
        b.addEventListener('click', () => {
          if (n === count) {
            score += 1;
            updateScore();
            msg.textContent = 'Yes!';
            audio.speak('Yes!');
            audio.playSfx('ding');
            setTimeout(nextRound, 700);
          } else {
            msg.textContent = 'Try again!';
            audio.speak('Try again!');
            audio.playSfx('buzz');
          }
        });
        answers.appendChild(b);
      });
    }

    updateScore();
    nextRound();
  }
  initFruit();
  document.addEventListener('astro:page-load', initFruit);
</script>

<style>
  .game {
    background:#fff4f4;
    padding:1rem;
    border-radius:14px;
    border:2px solid #b24040;
    color:#3f1111;
    text-align: center;
  }
  .fruits {
    font-size: clamp(2.6rem, 10vw, 4rem);
    margin:.8rem 0;
    line-height: 1.15;
  }
  .score-line {
    margin: 0.25rem 0 0.5rem;
    font-size: clamp(1.05rem, 4.2vw, 1.3rem);
    font-weight: 800;
    color: #7a2020;
  }
  .answers {
    display:grid;
    grid-template-columns: repeat(3, minmax(78px, 1fr));
    gap:.7rem;
    max-width: 420px;
    margin: 0.4rem auto 0;
  }
  :global(.fruit-ans) {
    all: unset;
    box-sizing: border-box;
    min-height: 82px;
    border-radius:12px;
    border:2px solid #b24040;
    background:#fff;
    font-weight:700;
    font-size: clamp(1.7rem, 7vw, 2.3rem);
    color:#3f1111;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor: pointer;
  }
  [data-msg] {
    min-height: 1.6em;
    margin-top: .65rem;
    font-size: clamp(1.05rem, 4.8vw, 1.35rem);
    font-weight: 700;
  }
</style>
