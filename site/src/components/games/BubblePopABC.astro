<section class="game" data-bubble-root data-music-theme="bouncy">
  <h2>Bubble Pop ABC</h2>
  <p class="timer-line" data-timer-wrap hidden aria-label="Elapsed time">
    <span class="timer-icon" aria-hidden="true">⏱</span>
    <strong class="timer-digits" data-timer>0.0</strong>
  </p>
  <p class="stage-visual" data-stage>
    <span class="stage-letter" data-stage-from>A</span>
    <span class="stage-arrow" aria-hidden="true">→</span>
    <span class="stage-letter" data-stage-to>F</span>
  </p>
  <div class="row" data-row></div>
  <p class="feedback" data-feedback aria-live="polite"></p>
  <div class="finale" data-finale hidden>
    <p class="finale-stars" data-finale-stars aria-label="3 stars">★ ★ ★</p>
    <p class="finale-z">Z!</p>
    <p class="finale-time">
      <span class="timer-icon" aria-hidden="true">⏱</span>
      <strong data-finale-time></strong>
    </p>
  </div>
  <p class="next-wrap" data-next-wrap hidden>
    <button class="next-btn" data-next type="button" aria-label="Play again">Again!</button>
  </p>
</section>

<script>
  import { audio, bindActivityUnlock } from '../../lib/activityAudio';

  function initBubble() {
    const root = document.querySelector('[data-bubble-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    bindActivityUnlock(root, 'bouncy');

    const row = root.querySelector('[data-row]');
    const feedback = root.querySelector('[data-feedback]');
    const finale = root.querySelector('[data-finale]');
    const finaleStars = root.querySelector('[data-finale-stars]');
    const finaleTime = root.querySelector('[data-finale-time]');
    const stageFrom = root.querySelector('[data-stage-from]');
    const stageTo = root.querySelector('[data-stage-to]');
    const nextWrap = root.querySelector('[data-next-wrap]');
    const nextBtn = root.querySelector('[data-next]');
    const timerWrap = root.querySelector('[data-timer-wrap]');
    const timerEl = root.querySelector('[data-timer]');

    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
    const stageSize = 6;
    const stageWords = ['Yay!', 'Go!'];
    const ADVANCE_MS = 900;
    const CHEER_MS = 550;

    let stageStart = 0;
    let startTime = null;
    let timerInterval = null;
    let advancing = false;
    let hintBubble = null;
    let cheerTimer = null;

    function formatElapsed(ms) {
      const totalSec = ms / 1000;
      const min = Math.floor(totalSec / 60);
      const sec = totalSec % 60;
      if (min > 0) {
        return `${min}:${sec.toFixed(1).padStart(4, '0')}`;
      }
      return sec.toFixed(1);
    }

    function elapsedMs() {
      return startTime ? performance.now() - startTime : 0;
    }

    function updateTimerDisplay() {
      timerEl.textContent = formatElapsed(elapsedMs());
    }

    function startTimer() {
      if (startTime !== null) return;
      startTime = performance.now();
      timerWrap.hidden = false;
      updateTimerDisplay();
      timerInterval = window.setInterval(updateTimerDisplay, 100);
    }

    function stopTimer() {
      if (timerInterval !== null) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
      updateTimerDisplay();
    }

    function starsFromElapsedMs(ms) {
      const sec = ms / 1000;
      if (sec < 15) return 5;
      if (sec < 20) return 4;
      if (sec < 25) return 3;
      if (sec <= 30) return 2;
      return 1;
    }

    function renderStars(count) {
      return Array.from({ length: count }, () => '★').join(' ');
    }

    function clearHint() {
      if (hintBubble) {
        hintBubble.classList.remove('want');
        hintBubble = null;
      }
    }

    function setHint(letter) {
      clearHint();
      const bubbles = [...row.querySelectorAll('.bubble')];
      hintBubble =
        bubbles.find((el) => el.textContent === letter && !el.disabled) ?? null;
      if (hintBubble) hintBubble.classList.add('want');
    }

    function updateStageAria(from, to) {
      const stage = root.querySelector('[data-stage]');
      if (stage) stage.setAttribute('aria-label', `${from} to ${to}`);
    }

    function flashFeedback(kind, text = '') {
      if (cheerTimer) clearTimeout(cheerTimer);
      feedback.className = 'feedback';
      feedback.textContent = text;
      if (kind) feedback.classList.add(kind);
      if (text) {
        cheerTimer = window.setTimeout(() => {
          feedback.textContent = '';
          feedback.className = 'feedback';
        }, CHEER_MS);
      }
    }

    function flashWin() {
      root.classList.add('win-flash');
      window.setTimeout(() => root.classList.remove('win-flash'), 500);
    }

    function pickStageWord() {
      return stageWords[Math.floor(Math.random() * stageWords.length)];
    }

    function updateStageVisual(from, to) {
      stageFrom.textContent = from;
      stageTo.textContent = to;
      updateStageAria(from, to);
      audio.speak(from);
    }

    function advanceStage() {
      stageStart += stageSize;
      if (stageStart >= alphabet.length) stageStart = 0;
      advancing = false;
      feedback.textContent = '';
      feedback.className = 'feedback';
      renderStage();
    }

    function renderStage() {
      const current = alphabet.slice(stageStart, stageStart + stageSize);
      const ordered = [...current];
      const shuffled = [...current].sort(() => Math.random() - 0.5);
      let target = 0;

      row.innerHTML = '';
      clearHint();
      finale.hidden = true;
      nextWrap.hidden = true;
      updateStageVisual(ordered[0], ordered[ordered.length - 1]);

      shuffled.forEach((l) => {
        const b = document.createElement('button');
        b.textContent = l;
        b.className = 'bubble';
        b.type = 'button';
        b.setAttribute('aria-label', `Letter ${l}`);

        b.addEventListener('click', () => {
          if (advancing) return;

          if (l === ordered[target]) {
            startTimer();
            clearHint();
            b.disabled = true;
            b.classList.add('ok');
            audio.playSfx('pop');
            const cheer = target === 0 && stageStart === 0 ? 'Yay!' : '';
            if (cheer) {
              flashFeedback('cheer', cheer);
              audio.speak(cheer);
            }

            if (target === ordered.length - 1) {
              const finishedZ = ordered[ordered.length - 1] === 'Z';

              if (finishedZ) {
                advancing = true;
                stopTimer();
                const ms = elapsedMs();
                const stars = starsFromElapsedMs(ms);
                flashWin();
                root.classList.add('all-done');
                finaleStars.textContent = renderStars(stars);
                finaleStars.setAttribute('aria-label', `${stars} star${stars === 1 ? '' : 's'}`);
                finaleTime.textContent = formatElapsed(ms);
                feedback.textContent = '';
                finale.hidden = false;
                nextWrap.hidden = false;
                audio.speak('Z!');
              } else {
                advancing = true;
                flashWin();
                audio.playSfx('sparkle');
                const word = pickStageWord();
                flashFeedback('cheer', word);
                audio.speak(word);
                window.setTimeout(advanceStage, ADVANCE_MS);
              }
            } else {
              target += 1;
              setHint(ordered[target]);
            }
          } else {
            b.classList.remove('shake');
            void b.offsetWidth;
            b.classList.add('shake');
            setHint(ordered[target]);
            flashFeedback('hint-letter', ordered[target]);
            audio.playSfx('boing');
          }
        });

        row.appendChild(b);
      });

      setHint(ordered[0]);
    }

    function resetGame() {
      audio.stopAll();
      if (audio.musicOn) audio.startMusic('bouncy');
      stopTimer();
      startTime = null;
      stageStart = 0;
      advancing = false;
      root.classList.remove('all-done', 'win-flash');
      timerWrap.hidden = true;
      timerEl.textContent = '0.0';
      finale.hidden = true;
      feedback.textContent = '';
      feedback.className = 'feedback';
      clearHint();
      renderStage();
    }

    nextBtn.addEventListener('click', resetGame);
    renderStage();
  }

  initBubble();
  document.addEventListener('astro:page-load', initBubble);
</script>

<style>
  .game {
    background: #eff7ff;
    padding: 1rem;
    border-radius: 14px;
    border: 2px solid #2b5f9e;
    color: #10263f;
    text-align: center;
    transition: background 0.35s ease;
  }

  .game.win-flash {
    background: #e8ffe8;
  }

  .game.all-done {
    background: linear-gradient(180deg, #fff9c9 0%, #e8ffe8 100%);
  }

  .timer-line {
    margin: 0 0 0.45rem;
    font-size: 1.35rem;
    color: #1a4a7a;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .timer-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .timer-digits,
  .finale-time strong {
    font-variant-numeric: tabular-nums;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .stage-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }

  .stage-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 3px solid #2b5f9e;
    background: #fff;
    font-weight: 800;
    font-size: 1.5rem;
    color: #10263f;
  }

  .stage-arrow {
    font-size: 1.6rem;
    font-weight: 800;
    color: #2f6f4e;
    line-height: 1;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(3, minmax(88px, 1fr));
    gap: 0.8rem;
    max-width: 380px;
    margin: 0.8rem auto 0.4rem;
  }

  :global(.bubble) {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 3px solid #2b5f9e;
    background: #cfe9ff;
    font-weight: 800;
    font-size: clamp(2rem, 7vw, 3rem);
    color: #10263f;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 1;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.bubble:disabled) {
    cursor: default;
  }

  :global(.bubble.ok) {
    background: #7be08e;
    border-color: #24763b;
    color: #10361c;
    transform: scale(1.02);
  }

  :global(.bubble.want) {
    box-shadow: 0 0 0 4px #ffd54a, 0 0 18px rgba(255, 193, 7, 0.65);
    animation: pulse-want 0.85s ease-in-out infinite;
  }

  :global(.bubble.shake) {
    animation: shake-bubble 0.45s ease;
  }

  @keyframes pulse-want {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }

  @keyframes shake-bubble {
    0%,
    100% {
      transform: translateX(0);
    }
    20%,
    60% {
      transform: translateX(-6px);
    }
    40%,
    80% {
      transform: translateX(6px);
    }
  }

  .feedback {
    min-height: 2.8rem;
    margin: 0.15rem 0 0;
    font-weight: 800;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feedback.cheer {
    font-size: 1.75rem;
    color: #1f6b3a;
    animation: pop-cheer 0.5s ease;
  }

  .feedback.hint-letter {
    font-size: clamp(2.5rem, 12vw, 3.5rem);
    color: #b45309;
    animation: pop-cheer 0.35s ease;
  }

  @keyframes pop-cheer {
    0% {
      transform: scale(0.6);
      opacity: 0.4;
    }
    70% {
      transform: scale(1.12);
      opacity: 1;
    }
    100% {
      transform: scale(1);
    }
  }

  .finale {
    margin: 0.35rem 0 0;
    padding: 0.25rem 0;
  }

  .finale-stars {
    margin: 0;
    font-size: clamp(2rem, 10vw, 2.75rem);
    color: #e6a800;
    letter-spacing: 0.2em;
    line-height: 1.2;
    animation: pop-cheer 0.55s ease;
  }

  .finale-z {
    margin: 0.15rem 0 0.25rem;
    font-size: clamp(2.5rem, 14vw, 3.75rem);
    font-weight: 800;
    color: #1f5c2e;
    line-height: 1;
  }

  .finale-time {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: #1a4a7a;
  }

  .next-wrap {
    margin-top: 0.65rem;
  }

  .next-btn {
    border: 2px solid #2f6f4e;
    background: #2f6f4e;
    color: #fff;
    border-radius: 999px;
    padding: 0.6rem 1.35rem;
    font-weight: 800;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .next-btn:hover {
    background: #3a8a5f;
  }
</style>
