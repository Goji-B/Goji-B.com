<section class="game" data-trace-root>
  <h2>Trace the Path</h2>
  <p data-msg aria-live="polite">Press Start. Watch the path. Then trace it.</p>
  <div class="path" data-path></div>
  <div class="controls">
    <button class="start-btn" data-start type="button">Start</button>
  </div>
  <p class="reload-wrap" data-reload-wrap hidden>
    <button class="reload-btn" data-reload type="button">Reload Activity</button>
  </p>
</section>

<script>
  function initTrace() {
    const root = document.querySelector('[data-trace-root]');
    if (!root || root.dataset.init === '1') return;
    root.dataset.init = '1';
    const msg = root.querySelector('[data-msg]');
    const pathWrap = root.querySelector('[data-path]');
    const startBtn = root.querySelector('[data-start]');
    const reloadWrap = root.querySelector('[data-reload-wrap]');
    const reloadBtn = root.querySelector('[data-reload]');
    let dots = [];
    let path = [];
    let userIndex = 0;
    let showing = false;
    let dragging = false;

    function coord(index) {
      return [Math.floor(index / 5), index % 5];
    }

    function indexOf(r, c) {
      return r * 5 + c;
    }

    function neighbors(index) {
      const [r, c] = coord(index);
      const options = [];
      if (r > 0) options.push(indexOf(r - 1, c));
      if (r < 4) options.push(indexOf(r + 1, c));
      if (c > 0) options.push(indexOf(r, c - 1));
      if (c < 4) options.push(indexOf(r, c + 1));
      return options;
    }

    function clearState() {
      pathWrap.classList.remove('success-all', 'fail-all');
      dots.forEach((d) => d.classList.remove('ok', 'show', 'fail', 'start'));
    }

    function buildBoard() {
      pathWrap.innerHTML = '';
      dots = [];
      for (let i = 0; i < 25; i += 1) {
        const b = document.createElement('button');
        b.className = 'dot';
        b.type = 'button';
        b.dataset.index = String(i);
        pathWrap.appendChild(b);
        dots.push(b);
      }
    }

    function generatePath(length = 7) {
      const p = [];
      let current = Math.floor(Math.random() * 25);
      p.push(current);
      while (p.length < length) {
        const opts = neighbors(current).filter((n) => !p.includes(n));
        if (!opts.length) break;
        current = opts[Math.floor(Math.random() * opts.length)];
        p.push(current);
      }
      return p;
    }

    async function showPath() {
      showing = true;
      clearState();
      const wait = (ms) => new Promise((res) => setTimeout(res, ms));
      for (let i = 0; i < path.length; i += 1) {
        const d = dots[path[i]];
        d.classList.add('show');
        if (i === 0) d.classList.add('start');
        await wait(380);
        d.classList.remove('show');
      }
      dots[path[0]].classList.add('start');
      showing = false;
      userIndex = 0;
      msg.textContent = `Your turn: trace from the green start dot. Step 1 of ${path.length}.`;
    }

    function failRound() {
      const wrong = dots[path[userIndex]];
      if (wrong) wrong.classList.add('fail');
      pathWrap.classList.add('fail-all');
      msg.textContent = 'Oops! Wrong path. Press Reload to try again.';
      reloadWrap.hidden = false;
      dragging = false;
    }

    function completeRound() {
      pathWrap.classList.add('success-all');
      msg.textContent = 'Fantastic tracing! Press Reload for a new path.';
      reloadWrap.hidden = false;
      dragging = false;
    }

    function handlePick(dot) {
      if (showing || reloadWrap.hidden === false) return;
      const picked = Number(dot.dataset.index);
      if (Number.isNaN(picked)) return;
      if (picked !== path[userIndex]) {
        failRound();
        return;
      }
      dot.classList.add('ok');
      userIndex += 1;
      if (userIndex >= path.length) completeRound();
      else msg.textContent = `Good! Step ${userIndex + 1} of ${path.length}.`;
    }

    pathWrap.addEventListener('pointerdown', (e) => {
      const dot = e.target.closest('.dot');
      if (!dot) return;
      dragging = true;
      handlePick(dot);
    });
    pathWrap.addEventListener('pointerenter', (e) => {
      const dot = e.target.closest('.dot');
      if (!dragging || !dot) return;
      handlePick(dot);
    }, true);
    window.addEventListener('pointerup', () => { dragging = false; });

    function startRound() {
      path = generatePath(7);
      reloadWrap.hidden = true;
      msg.textContent = 'Watch carefully...';
      showPath();
    }

    startBtn.addEventListener('click', startRound);
    reloadBtn.addEventListener('click', startRound);
    buildBoard();
  }
  initTrace();
  document.addEventListener('astro:page-load', initTrace);
</script>

<style>
  .game {
    background:#eef6ff;
    padding:1rem;
    border-radius:14px;
    border:2px solid #3969a8;
    color:#112644;
    text-align: center;
  }
  .path {
    display:grid;
    grid-template-columns: repeat(5, minmax(52px, 1fr));
    gap:.55rem;
    max-width: 420px;
    margin: .7rem auto 0;
  }
  :global(.dot) {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius:50%;
    border:2px solid #3969a8;
    background:#fff;
    font-weight:700;
    font-size: clamp(1.1rem, 4.2vw, 1.5rem);
    color:#112644;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor: pointer;
    transition: transform .12s ease, background-color .12s ease, box-shadow .12s ease;
  }
  :global(.dot.start) {
    background: #c3f3cd;
    border-color: #2d8d45;
  }
  :global(.dot.show) {
    background: #8fc4ff;
    border-color: #2267ad;
    transform: scale(1.08);
    box-shadow: 0 0 0 3px rgba(34, 103, 173, 0.2);
  }
  :global(.dot.ok) {
    background:#bde7ff;
    border-color:#2267ad;
  }
  :global(.dot.fail) {
    background:#ffd4d4;
    border-color:#cc3a3a;
  }
  .path.success-all :global(.dot) {
    background: #8df1a5;
    border-color: #2f8b49;
    animation: burst-pop .45s ease 2;
  }
  .path.fail-all :global(.dot) {
    background: #ffd1eb;
    border-color: #c9498f;
  }
  @keyframes burst-pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }
  [data-msg] {
    min-height: 1.6em;
    font-size: clamp(1.05rem, 4.7vw, 1.3rem);
    font-weight: 700;
  }
  .controls { margin-top: .75rem; }
  .start-btn {
    border:2px solid #3969a8;
    background:#3969a8;
    color:#fff;
    border-radius:999px;
    padding:.55rem 1.1rem;
    font-weight:700;
    cursor:pointer;
  }
  .reload-wrap { margin-top: .8rem; }
  .reload-btn {
    border:2px solid #2f6f4e;
    background:#2f6f4e;
    color:#fff;
    border-radius:999px;
    padding:.55rem 1.1rem;
    font-weight:700;
    cursor:pointer;
  }
</style>
