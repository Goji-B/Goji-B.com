<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GojiBerry Banner Sample</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 1rem;
      }

      .banner {
        width: min(960px, 95vw);
        height: auto;
        border: 2px solid #e3e3e3;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
        background: #fff;
      }
    </style>
  </head>
  <body>
    <img class="banner" src="/gojiberry-banner-split.png" alt="Split banner sample" />
  </body>
</html>
